!**/migrations/__init__.py

# Base de datos local
*.sqlite3
db.sqlite3

# Variables de entorno y credenciales
.env
local_settings.py

# Archivos de logs
*.log

# Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos de sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
